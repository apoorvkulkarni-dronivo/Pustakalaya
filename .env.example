# Copy to .env in the project root and fill in from Firebase Console → Project settings → Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Required for cover images (Firebase Console → Storage, or web app config)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — enables Google Analytics in Firebase (same as Console → Web app config)
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — Google Books API key (improves ISBN lookup when shared quota is exceeded; Google Cloud → APIs → Books)
# VITE_GOOGLE_BOOKS_API_KEY=

# Dev only — add to .env.development (see that file) to skip the sign-in screen while running npm run dev
# VITE_DEV_SKIP_AUTH=true
